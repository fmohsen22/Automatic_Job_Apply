{
  "schemaVersion": 1,
  "id": "base-cv-paste-import",
  "title": "Import a base CV by pasting text",
  "feature": "base-cv",
  "tags": ["cv"],
  "steps": [
    { "description": "Open the app", "action": "goto", "value": "http://127.0.0.1:4173" },
    { "description": "Go to Base CV", "action": "click", "target": [{ "strategy": "role", "value": "button", "name": "Base CV" }] },
    { "description": "Base CV Import heading visible", "action": "expect", "target": [{ "strategy": "role", "value": "heading", "name": "Base CV Import" }], "expect": { "type": "visible" } },
    { "description": "Set the version label", "action": "fill", "target": [{ "strategy": "role", "value": "textbox", "name": "Version Label" }, { "strategy": "css", "value": "form.import-panel input[type=text]" }], "value": "UITest Paste CV" },
    { "description": "Paste CV text into the content box", "action": "fill", "target": [{ "strategy": "placeholder", "value": "Paste CV text" }, { "strategy": "css", "value": "form.import-panel textarea" }], "value": "Mohsen Fakhari. AI automation engineer with petroleum background. Skills: Python, TypeScript, RAG, Playwright. Experience: built automation used daily by 50+ engineers." },
    { "description": "Click Import Base CV", "action": "click", "target": [{ "strategy": "role", "value": "button", "name": "Import Base CV" }] },
    { "description": "Import confirmation appears", "action": "expect", "target": [{ "strategy": "text", "value": "Imported" }], "expect": { "type": "visible" }, "timeoutMs": 15000 }
  ]
}
