{
  "schemaVersion": 1,
  "id": "prepare-exact-format-and-apply",
  "title": "Upload Word base CV (auto-set as template), tailor it in exact format, download Word/PDF, run apply worker",
  "feature": "prepare",
  "tags": ["e2e"],
  "steps": [
    { "description": "Open the app", "action": "goto", "value": "http://127.0.0.1:4173" },

    { "description": "Go to Base CV", "action": "click", "target": [{ "strategy": "role", "value": "button", "name": "Base CV" }] },
    { "description": "Upload the Word CV as the base CV", "action": "upload", "target": [{ "strategy": "css", "value": ".basecv-upload input[type=file]" }], "value": "../../fixtures/sample_cv.docx" },
    { "description": "Base CV is saved and set as the template automatically", "action": "waitFor", "waitFor": { "text": "Base CV saved and set as your template", "state": "visible" }, "timeoutMs": 30000 },

    { "description": "Go to My Materials", "action": "click", "target": [{ "strategy": "role", "value": "button", "name": "My Materials" }] },
    { "description": "Select the uploaded Word CV in the materials list", "action": "click", "target": [{ "strategy": "role", "value": "button", "name": "sample_cv" }, { "strategy": "text", "value": "sample_cv" }] },
    { "description": "It is badged as the Base CV / Template", "action": "expect", "target": [{ "strategy": "text", "value": "Base CV / Template" }], "expect": { "type": "visible" } },
    { "description": "Use as Template action exists for promoting materials", "action": "expect", "target": [{ "strategy": "role", "value": "button", "name": "Use as Template" }], "expect": { "type": "visible" } },

    { "description": "Go to Job Search", "action": "click", "target": [{ "strategy": "role", "value": "button", "name": "Job Search" }] },
    { "description": "Open the first ranked job", "action": "click", "target": [{ "strategy": "role", "value": "button", "name": "Review & Prepare" }] },
    { "description": "Job detail generate panel is visible", "action": "expect", "target": [{ "strategy": "role", "value": "heading", "name": "Generate / Update CV" }], "expect": { "type": "visible" }, "timeoutMs": 15000 },

    { "description": "Choose the exact-Word output format", "action": "select", "target": [{ "strategy": "role", "value": "combobox", "name": "Output format" }, { "strategy": "css", "value": "select[aria-label='Output format']" }], "value": "word", "timeoutMs": 15000 },
    { "description": "Click Generate Materials (AI tailoring)", "action": "click", "target": [{ "strategy": "role", "value": "button", "name": "Generate Materials" }, { "strategy": "role", "value": "button", "name": "Regenerate Materials" }] },
    { "description": "Wait for tailoring to complete", "action": "waitFor", "waitFor": { "text": "tailored materials are ready", "state": "visible" }, "timeoutMs": 120000 },
    { "description": "Tailored CV is in exact Word format", "action": "waitFor", "waitFor": { "text": "Exact Word format", "state": "visible" }, "timeoutMs": 30000 },
    { "description": "Word download link is available", "action": "expect", "target": [{ "strategy": "role", "value": "link", "name": "Word" }], "expect": { "type": "visible" } },
    { "description": "PDF download link is available", "action": "expect", "target": [{ "strategy": "role", "value": "link", "name": "PDF" }], "expect": { "type": "visible" } },
    { "description": "Requirements checklist was produced", "action": "expect", "target": [{ "strategy": "role", "value": "heading", "name": "Requirements Checklist" }], "expect": { "type": "visible" } },

    { "description": "Run the apply worker (browser dry-run)", "action": "click", "target": [{ "strategy": "role", "value": "button", "name": "Run Browser Check" }] },
    { "description": "Apply worker finishes and reports a status", "action": "waitFor", "waitFor": { "text": "Worker finished", "state": "visible" }, "timeoutMs": 120000 },
    { "description": "Application Runs panel shows the run", "action": "expect", "target": [{ "strategy": "role", "value": "heading", "name": "Application Runs" }], "expect": { "type": "visible" } }
  ]
}
